{
  "name": "benchdesk",
  "productName": "Benchdesk",
  "version": "0.9.0",
  "private": true,
  "description": "One desk for your companies, goals and tasks, with Claude Code, Codex and your terminal right next to them.",
  "author": "Arcgent",
  "type": "module",
  "main": "dist/electron/main.cjs",
  "scripts": {
    "mobile": "node scripts/mobile.mjs",
    "mobile:build": "node scripts/mobile.mjs --build",
    "mobile:start": "node scripts/mobile.mjs --start",
    "test:mobile": "node scripts/test-mobile.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "generate:icon": "node scripts/generate-icon.mjs",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "test": "node scripts/build.mjs --tests && node scripts/test.mjs",
    "test:ui": "node scripts/smoke-pro.mjs",
    "test:agents": "node scripts/smoke-agents.mjs",
    "test:today": "node scripts/smoke-dashboard.mjs",
    "test:dashboard": "node scripts/smoke-dashboard.mjs",
    "test:language": "node scripts/smoke-language.mjs",
    "test:recurring": "node scripts/smoke-recurring.mjs",
    "test:integrations": "node scripts/smoke-integrations.mjs",
    "test:schedules": "node scripts/smoke-schedules.mjs",
    "test:computer": "node scripts/smoke-computer.mjs",
    "test:colors": "node scripts/smoke-terminal-colors.mjs",
    "test:upgrade": "node scripts/smoke-upgrade.mjs",
    "test:web": "node scripts/smoke-web.mjs",
    "test:all": "npm test && npm run build && npm run test:ui && npm run test:today && npm run test:language && npm run test:recurring && npm run test:computer && npm run test:colors && npm run test:integrations && npm run test:schedules && npm run test:upgrade && npm run test:web",
    "package": "npm run build && electron-builder --mac dir && node scripts/check-mac-signing.mjs",
    "postinstall": "electron-rebuild -f -w better-sqlite3,node-pty",
    "web": "npm run build && node scripts/web.mjs",
    "web:start": "node scripts/web.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.1.76",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/dm-sans": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/headless": "^5.5.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^12.6.0",
    "cron-parser": "^5.10.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "43.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  },
  "build": {
    "appId": "nl.arcgent.werk",
    "productName": "Benchdesk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/tests/**/*",
      "!dist/native/**/*",
      "!dist/web/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/node-pty/**/*",
      "**/better-sqlite3/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": "Benchdesk Dev",
      "target": [
        "dir"
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": false
    }
  }
}
